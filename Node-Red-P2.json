        "func": "if (msg.statusCode === 200 || msg.statusCode === 201) {\n    node.status({ fill: 'green', shape: 'dot', text: '✓ ' + msg.statusCode + ' OK — ' + new Date().toLocaleTimeString() });\n} else {\n    node.status({ fill: 'red', shape: 'ring', text: '✗ Error ' + msg.statusCode });\n}\nreturn msg;",
