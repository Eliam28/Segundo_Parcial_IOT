    {
        "id": "b224ccd40bbc5cb6",
        "type": "function",
        "z": "1e60a01a40afbb6d",
        "name": "Distribuir a gauges",
        "func": "let d = msg.payload;\nlet ts = new Date();\n// Actualizar lógica automática también\nlet modo = flow.get('modo') || 'automatico';\nif (modo === 'automatico') {\n    if (d.temp > 32) {\n        let m = { payload: JSON.stringify({ actuador: 'ventilador', accion: 'ON' }), headers: { 'Content-Type': 'application/json' } };\n        node.send([null, null, null, null, m, null]);\n    } else if (d.hum < 35) {\n        let m = { payload: JSON.stringify({ actuador: 'riego', accion: 'ON' }), headers: { 'Content-Type': 'application/json' } };\n        node.send([null, null, null, null, null, m]);\n    } else {\n        // Desactivar ambos\n        let mv = { payload: JSON.stringify({ actuador: 'ventilador', accion: 'OFF' }), headers: { 'Content-Type': 'application/json' } };\n        let mr = { payload: JSON.stringify({ actuador: 'riego', accion: 'OFF' }), headers: { 'Content-Type': 'application/json' } };\n        node.send([null, null, null, null, mv, mr]);\n    }\n}\nreturn [\n    { payload: d.temp },\n    { payload: d.hum },\n    { payload: d.co2 },\n    { payload: d.temp, topic: 'Temperatura' }\n];",
