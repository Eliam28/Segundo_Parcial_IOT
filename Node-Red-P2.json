        "name": "Agregar timestamp + guardar contexto",
        "func": "// Enriquecer payload con timestamp ISO 8601\nmsg.payload.timestamp = new Date().toISOString();\n\n// Guardar en contexto del flujo para el dashboard\nflow.set('ultimosSensores', msg.payload);\n\n// Header necesario para la API\nmsg.headers = { 'Content-Type': 'application/json' };\n\nnode.status({ fill: 'green', shape: 'dot', text: 'temp: ' + msg.payload.temp + '°C' });\n\nreturn msg;",
