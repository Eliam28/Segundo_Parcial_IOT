    {
        "id": "0d916f47090b4003",
        "type": "function",
        "z": "1e60a01a40afbb6d",
        "name": "Enviar a Dashboard",
        "func": "// Separar por actuador para actualizar cada indicador visual\nlet ack = msg.payload;\n\nif (ack.actuador === 'riego') {\n    msg.payload = ack.estado;\n    return [msg, null];\n} else if (ack.actuador === 'ventilador') {\n    msg.payload = ack.estado;\n    return [null, msg];\n}\nreturn null;",
