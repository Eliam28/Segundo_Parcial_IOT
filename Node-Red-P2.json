    {
        "id": "0d6cad6d05975dd8",
        "type": "function",
        "z": "1e60a01a40afbb6d",
        "name": "Actualizar estado actuadores",
        "func": "let ack = msg.payload;\n// ack = { actuador: 'ventilador', estado: 'ON', ts: 1234567890 }\n\n// Guardar estado en contexto del flujo\nlet actuadores = flow.get('actuadores') || { riego: 'OFF', ventilador: 'OFF' };\nactuadores[ack.actuador] = ack.estado;\nflow.set('actuadores', actuadores);\n\nnode.status({ fill: 'green', shape: 'dot', text: ack.actuador + ' → ' + ack.estado });\n\n// Preparar mensaje para el dashboard\nmsg.payload = ack;\nmsg.topic = ack.actuador;\n\nreturn msg;",
        "outputs": 1,
