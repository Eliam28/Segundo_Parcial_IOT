    {
        "id": "16a67a2b531bf611",
        "type": "function",
        "z": "1e60a01a40afbb6d",
        "name": "¿Hay comandos?",
        "func": "// La API devuelve un array de comandos pendientes\nlet comandos = msg.payload;\n\n// Si no es array o está vacío, no hacer nada\nif (!Array.isArray(comandos) || comandos.length === 0) {\n    node.status({ fill: 'grey', shape: 'ring', text: 'Sin comandos — ' + new Date().toLocaleTimeString() });\n    return null;\n}\n\nnode.status({ fill: 'yellow', shape: 'dot', text: comandos.length + ' comando(s) recibidos' });\n\n// Enviar cada comando como mensaje separado\nlet mensajes = comandos.map(cmd => ({ payload: cmd }));\nreturn [mensajes];",
        "outputs": 1,
        "x": 560,
        "y": 420,
        "wires": [
            [
                "8468b386455483a8"
            ]
        ]
    },
    {
        "id": "8468b386455483a8",
        "type": "function",
        "z": "1e60a01a40afbb6d",
        "name": "Rutear por actuador",
        "func": "let cmd = msg.payload;\nlet actuador = cmd.actuador;\nlet accion = cmd.accion;\n\n// Guardar modo manual en contexto\nflow.set('modo', 'manual');\n\nif (actuador === 'riego') {\n    msg.topic = 'invernadero/control/riego';\n    msg.payload = accion;\n    node.status({ fill: 'blue', shape: 'dot', text: 'Riego → ' + accion });\n    return [msg, null];\n} else if (actuador === 'ventilador') {\n    msg.topic = 'invernadero/control/ventilador';\n    msg.payload = accion;\n    node.status({ fill: 'blue', shape: 'dot', text: 'Ventilador → ' + accion });\n    return [null, msg];\n}\nreturn null;",
        "outputs": 2,
